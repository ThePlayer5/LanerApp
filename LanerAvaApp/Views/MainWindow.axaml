<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        mc:Ignorable="d" Width="800" Height="450"
        x:Class="LanerAvaApp.Views.MainWindow"
        x:Name="MainW"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None">

    <Window.Styles>
        <Style Selector="Border">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#02261d"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#EEFAF7"/>
            <Setter Property="Foreground" Value="#044031"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Resources>
                <SolidColorBrush
                    x:Key="TextControlBorderBrushPointerOver" Color="#D1F3C9"/>
                <SolidColorBrush
                    x:Key="TextControlBorderBrushFocused" Color="#D1F3C9"/>
            </Style.Resources>
        </Style>
        <Style Selector="Image.InnerIcon">
            <Setter Property="Margin" Value="10 0 0 0"/>
            <Setter Property="MaxHeight" Value="15"/>
            <Setter Property="MaxWidth" Value="15"/>
        </Style>
        <Style Selector="Button.MainBtnStyle">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="35, 12"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="#60B05E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Arrow">
            <Setter Property="Padding" Value="15, 13"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CornerRadius" Value="50"/>
            <Setter Property="Background" Value="#8BB955"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.DataGridBtn">
            <Setter Property="Padding" Value="15, 10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#044031"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="CheckBox">
            <Style.Resources>
                <SolidColorBrush
                    x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#EEFAF7"/>
                <SolidColorBrush
                    x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="LightGray"/>
                <SolidColorBrush
                    x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#60B05E"/>
                <SolidColorBrush
                    x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#CEEFC4"/>
                <SolidColorBrush
                    x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#D1F3C9"/>
                <SolidColorBrush
                    x:Key="CheckBoxCheckBackgroundFillChecked" Color="#60B05E"/>
                <SolidColorBrush
                    x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#8BB955"/>
                <SolidColorBrush
                    x:Key="CheckBoxForegroundUnchecked" Color="#044031"/>
            </Style.Resources>
        </Style>
        <Style Selector="HyperlinkButton">
            <Setter Property="Padding" Value="0"/>
            <Style Selector="^ TextBlock">
                <Setter Property="TextDecorations" Value="Underline"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#60B455"/>
            </Style>
        </Style>
        <Style Selector="ProgressBar.Card">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Foreground" Value="#60B455"/>
            <Setter Property="Background" Value="#55FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="10"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="BorderBrush" Value="#044031"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="BorderBrush" Value="#f0f0f0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#044031"/>
            <Style Selector="^ TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
        </Style>
        <Style Selector="DataGridRow">
            <Style Selector="^ TextBlock">
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#D1F3C9"/>
        </Style>
    </Window.Styles>

     <Grid RowDefinitions="Auto, *" ColumnDefinitions="Auto, *">
         <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                BorderBrush="#E4EAE8"
                BorderThickness="0 0 0 1"
                CornerRadius="0 0 5 0"
                chrome:WindowDecorationProperties.ElementRole="TitleBar">
             <DockPanel>
                <DockPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Width" Value="50"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="0"/>
                    </Style>
                    <Style Selector="Button.CloseBtn:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#1B5E3A" />
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </DockPanel.Styles>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            DockPanel.Dock="Left"
                            Spacing="5"
                            Margin="20,0">
                    <Image Source="/Assets/laner-logo.png"
                            MaxWidth="35"
                            MaxHeight="35"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="Laner"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="16"/>
                </StackPanel>
                        
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            chrome:WindowDecorationProperties.ElementRole="User"
                            DockPanel.Dock="Right">
                    <Button x:Name="MinimizeBtn"
                            Click="MinimizeBtn_Click"
                            Content="—"/>
                    <Button x:Name="FullScreenBtn"
                            Click="FullScreenBtn_Click"
                            Content="□"/>
                    <Button x:Name="CloseBtn"
                            Content="✕"
                            Click="CloseBtn_Click"
                            Classes="CloseBtn"/>
                </StackPanel>
             </DockPanel>
         </Border>

         <Border Grid.Row="1"
                 Grid.Column="0"
                 x:Name="NavPanel"
                 IsVisible="False"
                 BorderBrush="#E4EAE8"
                 BorderThickness="0 0 1 0"
                 CornerRadius="0 0 5 0">
             <DockPanel LastChildFill="False"
                        Margin="10">
                 <DockPanel.Styles>
                     <Style Selector="Button">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="5"/>
                        <Setter Property="Padding" Value="10, 10" />
                    </Style>
                     <Style Selector="Button.NavBtn">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                     <Style Selector="Button.NavBtn:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#EDFBEA" />
                    </Style>
                    <Style Selector="Image">
                        <Setter Property="Width" Value="20" />
                        <Setter Property="Height" Value="20" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style Selector="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                    <Style Selector="StackPanel.BtnContent">
                        <Setter Property="Orientation" Value="Horizontal" />
                        <Setter Property="Spacing" Value="10" />
                    </Style>
                 </DockPanel.Styles>

                 <StackPanel DockPanel.Dock="Top">
                     <Button x:Name="HomePageBtn"
                             Classes="NavBtn"
                             Click="HomePageBtn_Click">
                         <StackPanel Classes="BtnContent">
                             <Image Source="/Assets/home-icon.png"/>
                             <TextBlock Text="Главная"/>
                         </StackPanel>
                     </Button>
                     <Button x:Name="SupportPageBtn"
                             Classes="NavBtn"
                             Click="SupportPageBtn_Click">
                         <StackPanel Classes="BtnContent">
                             <Image Source="/Assets/tech-support-icon.png"/>
                             <TextBlock Text="Тех. поддержка"/>
                         </StackPanel>
                     </Button>
                     <Button x:Name="ChatsPageBtn"
                             Classes="NavBtn"
                             Click="ChatsPageBtn_Click">
                         <StackPanel Classes="BtnContent">
                             <Image Source="/Assets/chats-icon.png"/>
                             <TextBlock Text="Чаты"/>
                         </StackPanel>
                     </Button>
                     <Button x:Name="AlphPageBtn"
                             Classes="NavBtn"
                             Click="AlphPageBtn_Click">
                         <StackPanel Classes="BtnContent">
                             <Image Source="/Assets/alphabet-icon.png"/>
                             <TextBlock Text="Алфавиты"/>
                         </StackPanel>
                     </Button>
                     <Button x:Name="AdminPanelBtn"
                             Classes="NavBtn"
                             Click="AdminPanelBtn_Click">
                         <StackPanel Classes="BtnContent">
                             <Image Source="/Assets/admin-icon.png"/>
                             <TextBlock Text="Админ панель"/>
                         </StackPanel>
                     </Button>
                     <Button x:Name="GamePageBtn"
                             Classes="NavBtn"
                             Click="GamePageBtn_Click">
                         <StackPanel Classes="BtnContent">
                             <Image Source="/Assets/pairs-game-icon.png"/>
                             <TextBlock Text="Найди пары"/>
                         </StackPanel>
                     </Button>
                     <Button x:Name="CompareGameBtn"
                             Classes="NavBtn"
                             Click="CompareGameBtn_Click">
                         <StackPanel Classes="BtnContent">
                             <Image Source="/Assets/compare-icon.png"/>
                             <TextBlock Text="Составить пары"/>
                         </StackPanel>
                     </Button>
                     <Button x:Name="RatingPageBtn"
                             Classes="NavBtn"
                             Click="RatingPageBtn_Click">
                         <StackPanel Classes="BtnContent">
                             <Image Source="/Assets/rating-icon.png"/>
                             <TextBlock Text="Рейтинг"/>
                         </StackPanel>
                     </Button>
                 </StackPanel>

                 <StackPanel DockPanel.Dock="Bottom">
                     <Button x:Name="ProfilePageBtn"
                             Classes="NavBtn"
                             Padding="10, 5"
                             Click="ProfilePageBtn_Click">
                         <StackPanel Classes="BtnContent"
                                     Spacing="7">
                             <Image Source="/Assets/profile-icon.png"
                                    Height="25"
                                    Width="25"/>
                             <StackPanel Spacing="2">
                                <TextBlock Text="Матвей" x:Name="FullnameText"/>
                                <TextBlock Text="mat@gmail.com" x:Name="EmailText"/>
                             </StackPanel>
                         </StackPanel>
                     </Button>
                 </StackPanel>
             </DockPanel>
         </Border>

         <ContentControl Grid.Column="1"
                         Grid.Row="1"
                         Margin="10"
                         x:Name="MainControl"/>
    </Grid>

</Window>
