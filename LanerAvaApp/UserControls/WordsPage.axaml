<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LanerAvaApp.UserControls.WordsPage">

    <Grid RowDefinitions="Auto, *, Auto">
        <Grid.Styles>
            <Style Selector="Border.Card">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </Grid.Styles>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Изучение слов"
                       FontSize="22"
                       Margin="5"
                       FontWeight="SemiBold"
                       x:Name="WelcomeText"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    Classes="Arrow"
                    Content="◀"
                    x:Name="PrevButton"
                    Click="PrevButton_Click"
                    Margin="5"/>

            <Carousel Grid.Column="1"
                      x:Name="WordsCarousel"
                      SelectionChanged="WordsCarousel_SelectionChanged">
                <Carousel.PageTransition>
                    <PageSlide Duration="0:00:00.25" Orientation="Horizontal"/>
                </Carousel.PageTransition>
                <Carousel.ItemTemplate>
                    <DataTemplate>
                        <Border Width="420" Height="260"
                                CornerRadius="18"
                                BorderBrush="LightGray"
                                ClipToBounds="True"
                                Margin="16"
                                Classes="Card"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BoxShadow="0 4 16 0 #30000000">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        Spacing="14"
                                        Margin="18,0">
                                <TextBlock Text="{Binding Word1}"
                                           FontSize="40"
                                           FontWeight="Bold"
                                           Foreground="Black"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Transcription}"
                                           FontSize="20"
                                           FontStyle="Italic"
                                           Foreground="Gray"
                                           HorizontalAlignment="Center"/>
                                <Rectangle Height="1"
                                           Fill="#D0D0D0"
                                           HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding Translation}"
                                           FontSize="26"
                                           Margin="0 10 0 0"
                                           FontWeight="SemiBold"
                                           Foreground="#4D4D4D"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </Carousel.ItemTemplate>
            </Carousel>

            <Button Grid.Column="2"
                    Classes="Arrow"
                    Content="▶"
                    x:Name="NextButton"
                    Click="NextButton_Click"
                    Margin="5"/>
        </Grid>

        <Button x:Name="EndLessonBtn"
                Grid.Row="2"
                IsVisible="False"
                Click="EndLessonBtn_Click"
                Classes="MainBtnStyle"
                Content="Завершить урок"
                FontSize="18"
                HorizontalAlignment="Center"
                Margin="0 0 0 7"/>

        <Border x:Name="CongratsPanel"
                IsVisible="False"
                Grid.RowSpan="3"
                Background="#E0FFFFFF">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="14">
                <TextBlock Text="УРОК ПРОЙДЕН!"
                            FontSize="60"
                            HorizontalAlignment="Center"/>
                <TextBlock Text="Кол-во повторённых слов: 0"
                            x:Name="ReapetedQty"
                            FontSize="20"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"/>
                <TextBlock Text="Кол-во изученных слов: 0"
                            x:Name="LearnedQty"
                            FontSize="20"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"/>
                <Button x:Name="ExitToMenuBtn"
                        Click="ExitToMenuBtn_Click"
                        Classes="MainBtnStyle"
                        Content="В меню"
                        FontSize="24"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
