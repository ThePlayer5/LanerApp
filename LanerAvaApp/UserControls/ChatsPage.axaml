<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LanerAvaApp.UserControls.ChatsPage">

    <UserControl.Styles>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EEFAF7"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#D1F3C9"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#CEEFC4"/>
        </Style>

        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Background" Value="#60B05E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.chatName">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style Selector="TextBlock.chatPreview">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="TextBlock.emptyHint">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,40,0,0"/>
        </Style>
        <Style Selector="TextBlock.chatTime">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *">
        <StackPanel Grid.Row="0">
            <TextBlock Text="Добро пожаловать!"
                       FontSize="22"
                       Margin="5"
                       FontWeight="SemiBold"
                       x:Name="WelcomeText"/>

            <TextBlock Text="Выберите язык для изучения"
                       FontSize="16"
                       Margin="5,0"
                       FontWeight="SemiBold"
                       Foreground="Gray"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <TextBox x:Name="SearchBox"
                    TextChanged="SearchBox_TextChanged"
                     PlaceholderText="Поиск по ФИО..."
                     Padding="10,10,10,10">
                <TextBox.InnerLeftContent>
                    <Image Source="/Assets/search-icon.png"
                           Classes="InnerIcon"/>
                </TextBox.InnerLeftContent>           
            </TextBox>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D1F3C9"
                BorderThickness="1"
                CornerRadius="15"
                Padding="8">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="UsersList"
                            SelectionChanged="UsersList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto">

                                    <Border Grid.Column="0"
                                            Classes="avatar"
                                            Margin="0,0,14,0">
                                        <Image Source="/Assets/profile-icon.png"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Classes="chatName"
                                                       Text="{Binding Fullname}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1"
                                                       Classes="chatTime"
                                                       Text="{Binding TimeText}"
                                                       Margin="8,0,0,0"/>
                                        </Grid>
                                        <TextBlock Classes="chatPreview"
                                                   Text="{Binding LastMessageText}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Classes="emptyHint"
                           Text="Пользователи не найдены"
                           IsVisible="False"/>
            </Grid>
        </Border>
    </Grid>

</UserControl>
