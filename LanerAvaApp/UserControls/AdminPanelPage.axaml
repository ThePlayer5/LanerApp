<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LanerAvaApp.UserControls.AdminPanelPage">

    <Grid RowDefinitions="*">
        <Grid.Styles>
            <Style Selector="Button.DataGridBtn">
                <Setter Property="Background" Value="#60B05E"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="Padding" Value="18, 15"/>
                <Setter Property="Width" Value="250"/>
                <Setter Property="Height" Value="80"/>
                <Setter Property="CornerRadius" Value="25"/>
            </Style>
        </Grid.Styles>
        <StackPanel Spacing="15" Width="200"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <Button Classes="DataGridBtn"
                    x:Name="LangsBtn"
                    Click="LangsBtn_Click"
                    Content="Языки"/>
            <Button Classes="DataGridBtn"
                    x:Name="AlphsBtn"
                    Click="AlphsBtn_Click"
                    Content="Алфавиты"/>
            <Button Classes="DataGridBtn"
                    x:Name="WordsBtn"
                    Click="WordsBtn_Click"
                    Content="Слова"/>
        </StackPanel>
    </Grid>


</UserControl>
