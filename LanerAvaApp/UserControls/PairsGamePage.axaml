<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LanerAvaApp.UserControls.PairsGamePage">

    <UserControl.Styles>
        <Style Selector="Border.GameCard">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.GameCard:pointerover">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style Selector="Border.GameCard.Matched">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="BorderBrush" Value="#60B05E"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Border.CardBack">
            <Setter Property="Background" Value="#60B05E"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style Selector="Border.CardFront">
            <Setter Property="Background" Value="#EEFAF7"/> 
            <Setter Property="BorderBrush" Value="#D1F3C9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Border.CardFront TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="TextBlock.Stats">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="10,5">

        <TextBlock Grid.Row="0"
                   Text="Найдите все пары"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatsText"
                           Classes="Stats"
                           Text="Найдено: 0 / 8"/>
            </StackPanel>
            <Button x:Name="RestartBtn"
                    Classes="MainBtnStyle"
                    Content="Начать заново"
                    HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D1F3C9"
                BorderThickness="1"
                CornerRadius="15"
                Padding="0, 10">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CardsList"
                                  MaxWidth="600"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="GameCard"
                                        Classes.Matched="{Binding IsMatched}"
                                        Tapped="Border_Tapped">
                                    <Grid>
                                        <Border Classes="CardBack"
                                                IsVisible="{Binding !IsFaceUp}">
                                        </Border>
                                        <Border Classes="CardFront"
                                                IsVisible="{Binding IsFaceUp}">
                                            <TextBlock Text="{Binding Text}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Text="Нет слов для игры"
                           IsVisible="False"
                           FontSize="16"
                           Opacity="0.6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Border x:Name="VictoryPanel"
                        IsVisible="False"
                        Background="#E0FFFFFF">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="14">
                        <TextBlock Text="ПОБЕДА!"
                                   FontSize="64"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Все пары найдены!"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="PlayAgainBtn"
                                Classes="MainBtnStyle"
                                Content="Играть ещё"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
