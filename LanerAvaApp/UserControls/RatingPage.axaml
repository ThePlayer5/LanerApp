<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LanerAvaApp.UserControls.RatingPage">

    <UserControl.Styles>
        <Style Selector="Border.RankCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1F3C9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16 12"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>
        <Style Selector="Border.RankCard.First">
            <Setter Property="Background" Value="#FFE9A8"/>
            <Setter Property="BorderBrush" Value="#E5C100"/>
        </Style>
        <Style Selector="Border.RankCard.Second">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
        </Style>
        <Style Selector="Border.RankCard.Third">
            <Setter Property="Background" Value="#F0C9A3"/>
            <Setter Property="BorderBrush" Value="#C87E3C"/>
        </Style>

        <Style Selector="TextBlock.RankPlace">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="48"/>
        </Style>
        <Style Selector="TextBlock.RankName">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.RankValue">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.EmptyHint">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="10,5">
        <TextBlock Grid.Row="0"
                   Text="Рейтинг"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Margin="0 0 0 10"/>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0 0 0 10">
            <TextBlock Text="Сортировка:"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="SortSelector"
                      MinWidth="360"
                      SelectedIndex="0">
                <ComboBoxItem Content="По количеству изученных слов"/>
                <ComboBoxItem Content="По словам уровня «продвинутый»"/>
                <ComboBoxItem Content="По проценту прогресса"/>
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D1F3C9"
                BorderThickness="0"
                CornerRadius="15"
                Padding="5"
                MaxWidth="720"
                HorizontalAlignment="Stretch">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RatingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="RankCard"
                                        Classes.First="{Binding IsFirst}"
                                        Classes.Second="{Binding IsSecond}"
                                        Classes.Third="{Binding IsThird}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Classes="RankPlace"
                                                   Text="{Binding RankText}"/>
                                        <TextBlock Grid.Column="1"
                                                   Classes="RankName"
                                                   Text="{Binding Fullname}"
                                                   Margin="8 0 0 0"/>
                                        <TextBlock Grid.Column="2"
                                                   Classes="RankValue"
                                                   Text="{Binding ValueText}"
                                                   Margin="12 0 0 0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Classes="EmptyHint"
                           Text="Пока нет данных для рейтинга"
                           IsVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
